<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp launcher banner placeholder; replaced with real artwork in Plan 2 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#0B0B0F" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
